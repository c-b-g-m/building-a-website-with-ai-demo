---
// Site header — logo + primary nav. Navigation structure is fixed by brand-kit §6.
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';

const links = [
  // Menu is an in-page anchor on the home page.
  { label: 'Menu', href: isHome ? '#menu' : '/#menu' },
  { label: 'About', href: '/about' },
  { label: 'Visit', href: '/contact' },
  { label: 'Pricing', href: '/pricing' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label="Bayou Brew Coffee — home">
      <span>Bayou</span>
      <svg class="wordmark__leaf" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M21 3C11 3 4 9 4 17c0 1.5.3 3 .8 4.2C8 14 13 11 19 10c-5 2.5-8.5 6-10.4 11.2C16 21 21 14 21 3Z"
          fill="currentColor"
        />
      </svg>
      <span>Brew</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px;
    flex-wrap: wrap;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
    color: var(--bayou);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--bayou);
  }

  .wordmark__leaf {
    color: var(--bayou);
    transform: translateY(1px);
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }

  .site-nav a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    padding: 11px 2px;          /* keeps the 44px tap target */
    display: inline-block;
  }

  .site-nav a:hover {
    color: var(--bayou);
  }
</style>
